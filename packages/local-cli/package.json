{
  "name": "gemini-bridge-local-cli",
  "version": "1.0.0",
  "description": "Local CLI runner for Gemini Git Bridge with in-memory preflight validation",
  "type": "module",
  "main": "dist/cli.mjs",
  "bin": {
    "gemini-local": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.5.0"
  }
}
