# Gemini Git Bridge Environment Configuration Template
# Copy this file to .env and adjust values if needed.

# Dual-Secret for API authentication (matches Worker secret)
BRIDGE_SECRET=your_bridge_secret_here
WORKER_SECRET=your_bridge_secret_here

# GitHub Personal Access Token (for local-cli or local test runners)
# GITHUB_TOKEN=ghp_...
# GITHUB_PAT=ghp_...

# Gemini API Key (optional, for local-cli hybrid mode)
# GEMINI_API_KEY=...
